{
  "$schema": "https://busbar.agency/schemas/busbar-module-v2.json",
  "schemaVersion": "2",
  "type": "action",
  "module": {
    "id": "sf-metadata-retrieve",
    "name": "Retrieve Metadata",
    "category": "code",
    "icon": "pull",
    "blurb": "Retrieve Salesforce metadata into the repo as a source-format tree (or MDAPI zip).",
    "longDescription": "Retrieves org metadata through the Busbar SF API with a typed metadata model, then decomposes the MDAPI zip into source-format files committed to the repo for review and diffing.",
    "version": "v1",
    "compatibility": "fits",
    "compatibilityNote": null
  },
  "interface": {
    "uses": "busbar-actions/sf-metadata-retrieve@v1",
    "inputs": [
      {
        "name": "target",
        "type": "string",
        "label": "Output path",
        "default": "force-app/main/default",
        "help": "Where retrieved metadata is written in the repo."
      },
      {
        "name": "format",
        "type": "enum",
        "label": "Format",
        "options": ["source", "mdapi"],
        "default": "source"
      }
    ],
    "requires": ["sf-session"],
    "provides": ["metadata-source"]
  },
  "envelope": {
    "permissions": { "contents": "write" },
    "network": ["api.github.com", "*.salesforce.com", "*.force.com"],
    "safe-outputs": ["push-to-branch"],
    "sf-scopes": ["metadata-read"]
  },
  "publisher": {
    "id": "busbar/core",
    "name": "Busbar Core",
    "kind": "official",
    "verified": true,
    "blurb": "First-party. github.com/busbar-actions."
  }
}
